{
  "name": "foxgo-manager",
  "private": true,
  "version": "0.6.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:test": "vite --mode test",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test && npm run check:tree",
    "check:tree": "node scripts/check-tree.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "e2e:perf": "playwright test -c playwright.perf.config.ts",
    "fuel:update": "node scripts/fuel-update.mjs",
    "release": "node scripts/release.mjs",
    "deploy": "node scripts/guard-deploy.mjs && npm run build && npx firebase-tools deploy --only hosting --project foxgo-aed1f"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "antd": "^5.29.3",
    "dayjs": "^1.11.23",
    "motion": "^12.43.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  }
}
